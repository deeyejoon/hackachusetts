# Sage backend environment configuration.
# Copy this file to `.env` and fill in your real values.

# Required: your Hugging Face Inference API token (https://huggingface.co/settings/tokens)
HF_API_TOKEN=hf_your_token_here

# Optional: the model used for chat completions.
# Defaults to mistralai/Mistral-7B-Instruct-v0.2 if unset.
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# Optional: port the Flask server listens on. Defaults to 5000.
PORT=5000
